{
  "name": "mp-image-assistance",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:web:local": "VITE_HTTPS=false vite --host 127.0.0.1 --port 5174",
    "dev:local": "concurrently \"npm:dev:api\" \"npm:dev:web:local\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "mermaid": "^11.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7"
  }
}
